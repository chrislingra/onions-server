# which instance this checkout serves (the domain) -- per host, never shared
.instance
# the Toolserver checkout of step 7
src/
# nothing of the instance lives here (it is in /opt/<domain>), but just in case
site.env
state/
logs/
*.log
# Python's compile cache -- a leftover of the moment, never part of the installer
__pycache__/
*.pyc
